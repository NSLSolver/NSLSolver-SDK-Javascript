{
  "name": "nslsolver",
  "version": "1.1.0",
  "description": "Official Node.js SDK for the NSLSolver captcha solving API",
  "author": "NSLSolver",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "captcha",
    "solver",
    "turnstile",
    "cloudflare",
    "nslsolver",
    "captcha-solver",
    "cloudflare-turnstile",
    "challenge",
    "kasada"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NSLSolver/NSLSolver-SDK-Javascript"
  },
  "homepage": "https://docs.nslsolver.com",
  "bugs": {
    "url": "https://github.com/NSLSolver/NSLSolver-SDK-Javascript/issues"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
